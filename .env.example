# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────────────────────────
# ProBoy Control Center / first-party analytics (serverless API under /api)
# Set these in Vercel (Project → Settings → Environment Variables) and Netlify
# (Site configuration → Environment variables). NEVER commit real values and
# NEVER prefix them with VITE_ (that would publish them in the browser bundle).
# Run `npm run admin:setup` locally to generate the hash / secrets below.
# ─────────────────────────────────────────────────────────────────────────────

# Private storage (Upstash Redis REST). Vercel's Upstash/KV integration provides KV_REST_API_URL/TOKEN instead.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Owner login
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""        # scrypt hash from `npm run admin:setup`
ADMIN_TOTP_SECRET=""          # optional but required for "Remember this device" verification
SESSION_SECRET=""             # >= 32 random chars; signs/derives session, salt and encryption keys
DATA_ENCRYPTION_KEY=""        # optional; separate secret for AES-256-GCM record encryption

# Public site origin used to validate analytics requests
SITE_URL="https://proboy.vercel.app"

# Local development only: allow the non-durable in-memory store (never use in production)
# PROBOY_ALLOW_MEMORY_STORE=1
