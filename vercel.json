
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/(?!images/|intro-animation/|og-image\\.(png|jpg|webp)$|sitemap\\.xml$|robots\\.txt$|llms\\.txt$|favicon\\.ico$)(.*)$",
      "dest": "/index.html"
    },
    {
      "src": "^/.*$",
      "handle": "filesystem"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/intro-animation/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
